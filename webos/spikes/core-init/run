#!/usr/bin/env bash
# Mede o init do core de uma variante num emulador reservado pelo emu-run (spike F0.11):
#   webos/tools/build-run -- npx webpack --config webos/spikes/core-init/webpack.config.js --env variant=NOME
#   webos/tools/emu-run --profile c8 --timeout 20 -- webos/spikes/core-init/run [opções] NOME pasta-de-saída
# Opções:
#   --hide-wasm      o worker esconde o WebAssembly: o core sobe em wasm2js;
#   --early          o worker começa a carregar o core antes da mensagem init;
#   --cache idb      experimento do WebAssembly.Module guardado no IndexedDB (veja worker.js);
#   --launches N     lançamentos na mesma VM (padrão 3): o 1º é o "1º boot" do app (VM recém-criada,
#                    sem cache), os seguintes fecham e reabrem o app (cache de código do V8 para
#                    file://, cache de disco do sistema, Board salvo no localStorage).
# POST_SECS (padrão 90): amostragem de memória depois do 1º lançamento ("steady" = média dos
# últimos 30 s); POST_RELAUNCH_SECS (padrão 20) depois dos outros. SHOTS (padrão "4 10"): segundos
# depois de cada lançamento em que se tira uma captura QMP (o que a tela mostra enquanto o core sobe).
# Saída: <prefixo>.json (todos os lançamentos, memória do convidado por lançamento, carga do host),
# <prefixo>-mem.log, <prefixo>-L<n>-page.json, capturas <prefixo>-L<n>-<s>s.png e -L<n>-fim.png.
# Sai com 1 se algum lançamento falhar.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
TOOLS="$(cd "$HERE/../../tools" && pwd)"
APP_ID="io.github.gabrielsflores.coreinit"
POST_SECS="${POST_SECS:-90}"
POST_RELAUNCH_SECS="${POST_RELAUNCH_SECS:-20}"
SHOTS="${SHOTS:-4 10}"
LAUNCHES=3
PARAMS='{}'
TAG=wasm
VARIANT="" OUT_DIR=""
add_param() { PARAMS="$(python3 -I -c 'import json,sys; d=json.loads(sys.argv[1]); d[sys.argv[2]]=json.loads(sys.argv[3]); print(json.dumps(d))' "$PARAMS" "$1" "$2")"; }
while [[ $# -gt 0 ]]; do
    case "$1" in
        --hide-wasm) add_param webassembly '"hidden"'; TAG=wasm2js; shift ;;
        --early) add_param early true; TAG="$TAG-early"; shift ;;
        --cache) add_param cache "\"$2\""; TAG="$TAG-cache$2"; shift 2 ;;
        --launches) LAUNCHES="$2"; shift 2 ;;
        -*) sed -n '2,20p' "$0" >&2; exit 2 ;;
        *) if [[ -z "$VARIANT" ]]; then VARIANT="$1"; else OUT_DIR="$1"; fi; shift ;;
    esac
done
: "${EMU_DEVICE:?rode dentro do webos/tools/emu-run}"
[[ -n "$VARIANT" && -n "$OUT_DIR" ]] || { sed -n '2,20p' "$0" >&2; exit 2; }
APP_DIR="$HERE/build/app-$VARIANT"
[[ -f "$APP_DIR/worker.js" ]] || { echo "erro: falta o build em $APP_DIR (webpack, veja o cabeçalho)" >&2; exit 2; }
OUT_DIR="$(realpath -m "$OUT_DIR")"
mkdir -p "$OUT_DIR"
BASE="$OUT_DIR/$VARIANT-$TAG-${EMU_PROFILE:-semperfil}-$(date +%Y%m%d-%H%M%S)"

SSH=(ssh -q -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o HostKeyAlgorithms=+ssh-rsa
     -o PubkeyAcceptedAlgorithms=+ssh-rsa -o BatchMode=yes -i "$HOME/webos-tv-sdk/run/ares_webos_emul"
     -p "$EMU_SSH_PORT" developer@127.0.0.1)
CDP=(node "$TOOLS/cdp.mjs" --target "$APP_ID")
guest_now() { "${SSH[@]}" 'date +%s'; }
# Memória do convidado a cada segundo (o mesmo amostrador do webos/tests/core-smoke/run).
SAMPLER='while true; do
  a=$(grep MemAvailable /proc/meminfo | tr -s " " | cut -d" " -f2); top=""
  for s in /proc/[0-9]*/status; do
    n=$(sed -n "s/^Name:\t//p" "$s" 2>/dev/null); case "$n" in WebAppMgr*|*chrom*|*render*|wam*) ;; *) continue;; esac
    k=$(sed -n "s/^VmRSS:[^0-9]*\([0-9]*\).*/\1/p" "$s" 2>/dev/null); [ -n "$k" ] || continue
    p=${s#/proc/}; top="$top $n:${p%/status}:$k"
  done
  echo "$(date +%s) $a$top"; sleep 1
done'
shot() { "$TOOLS/emulator-qemu.sh" -i "$EMU_INSTANCE" screenshot "$1" >/dev/null 2>&1 || echo "aviso: captura QMP falhou ($1)" >&2; }
# Referência de CPU do host, a mesma do baseline-c8.sh: ≈ 600 ms com a máquina ociosa.
host_ref() { for _ in 1 2 3; do node -e 'var t=Date.now(),a=0;for(var i=0;i<30000000;i++){a=(a+i*i)%1000003}console.log(Date.now()-t)'; done | sort -n | head -1; }

UPTIME_START="$(uptime)"
HOST_REF_START="$(host_ref)"
echo "variante $VARIANT · $TAG · params $PARAMS · perfil ${EMU_PROFILE:-nenhum} · host: $UPTIME_START · ref ${HOST_REF_START} ms"
trap '[[ -n "${MON:-}" ]] && kill "$MON" 2>/dev/null || true' EXIT
"$HERE/package" "$VARIANT"
ares-install -d "$EMU_DEVICE" "$HERE/build/ipk-$VARIANT"/*.ipk

"${SSH[@]}" "$SAMPLER" > "$BASE-mem.log" 2>/dev/null &
MON=$!
sleep 5
LAUNCH_ROWS=()
for n in $(seq 1 "$LAUNCHES"); do
    G_LAUNCH="$(guest_now)"
    T_LAUNCH=$(date +%s%3N)
    ares-launch -d "$EMU_DEVICE" "$APP_ID" -p "$PARAMS" >/dev/null
    SHOT_PIDS=()
    for s in $SHOTS; do (sleep "$s"; shot "$BASE-L$n-${s}s.png") & SHOT_PIDS+=($!); done
    done=0
    for _ in $(seq 1 120); do
        if "${CDP[@]}" eval 'window.__f011 && window.__f011.done' 2>/dev/null | grep -q true; then done=1; break; fi
        sleep 1.5
    done
    T_DONE=$(date +%s%3N)
    wait "${SHOT_PIDS[@]}"
    # Relógio do convidado contra o do host (a página dá o navigationStart no relógio dela).
    H0=$(date +%s%3N)
    GUEST_MS="$("${CDP[@]}" eval 'Date.now()' 2>/dev/null || echo 0)"
    H1=$(date +%s%3N)
    "${CDP[@]}" eval 'JSON.stringify(window.__f011)' > "$BASE-L$n-page.json" 2>/dev/null || echo '{}' > "$BASE-L$n-page.json"
    shot "$BASE-L$n-fim.png"
    G_DONE="$(guest_now)"
    if [[ "$n" == 1 && "$done" == 1 ]]; then post="$POST_SECS"; else post="$POST_RELAUNCH_SECS"; fi
    echo "lançamento $n: $([[ $done == 1 ]] && echo concluído || echo TIMEOUT) em $(( (T_DONE - T_LAUNCH) / 1000 )) s; memória por mais $post s"
    sleep "$post"
    G_END="$(guest_now)"
    LAUNCH_ROWS+=("$n $T_LAUNCH $T_DONE $done $G_LAUNCH $G_DONE $G_END $H0 $H1 $GUEST_MS")
    ares-launch -d "$EMU_DEVICE" --close "$APP_ID" >/dev/null 2>&1 || true
    sleep 6
done
kill "$MON" 2>/dev/null || true
MON=""
"${SSH[@]}" free > "$BASE-free.txt" 2>&1 || true
UPTIME_END="$(uptime)"
HOST_REF_END="$(host_ref)"

printf '%s\n' "${LAUNCH_ROWS[@]}" | python3 -I "$HERE/summarize.py" run "$BASE" "$VARIANT" "$TAG" "$PARAMS" \
    "${EMU_PROFILE:-}" "$UPTIME_START" "$UPTIME_END" "$HOST_REF_START" "$HOST_REF_END" "$APP_DIR/variant.json"
