#!/usr/bin/env bash
# Reserva uma instância livre do pool de emuladores, sobe um boot limpo, roda o comando e desliga.
# A reserva é uma trava flock por instância (sem daemon): vários agentes testam ao mesmo tempo
# sem colisão, e a trava some sozinha se o processo morrer. Nenhum filho herda o FD da trava
# (`{LOCKFD}>&-`): um QEMU em segundo plano que o herdasse a seguraria depois de um SIGKILL do emu-run.
# Se o emu-run morrer à força, o QEMU fica órfão mas a trava é liberada; a próxima reserva da
# instância o encerra (`emulator-qemu.sh stop`) antes do boot limpo. O comando do usuário morre junto
# com o emu-run (setpriv --pdeathsig), para não agir no emulador da reserva seguinte.
#
#   emu-run [--instance N] [--keep-state] [--timeout MIN] [--profile c8] -- <comando...>
#
# Dentro do comando ficam definidos: EMU_INSTANCE, EMU_DEVICE (dispositivo ares), EMU_SSH_PORT,
# EMU_CDP_PORT (= CDP_PORT, usado pelo cdp.mjs), EMU_REMOTE_PORT, EMU_QMP (= WEBOS_QMP).
# --profile c8 (ou EMU_PROFILE=c8): VM com o perfil C8 (1 GB, 2 vCPUs, cota de CPU); sem ele, o boot é o de sempre.
# Padrão: overlay recriado a cada reserva (estado de fábrica). --keep-state reaproveita o disco.
# Tamanho do pool: $EMU_POOL_SIZE (padrão 4). Um cenário de mídia por reserva: o emulador só
# reproduz de forma confiável a primeira mídia após o boot.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
RUN="$HOME/webos-tv-sdk/run"
POOL="${EMU_POOL_SIZE:-4}"
want="" keep=0 timeout_min=60 profile="${EMU_PROFILE:-}"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --instance) want="$2"; shift 2 ;;
        --keep-state) keep=1; shift ;;
        --timeout) timeout_min="$2"; shift 2 ;;
        --profile) profile="$2"; shift 2 ;;
        --) shift; break ;;
        *) echo "uso: emu-run [--instance N] [--keep-state] [--timeout MIN] [--profile c8] -- comando" >&2; exit 1 ;;
    esac
done
[[ $# -gt 0 ]] || { echo "erro: falta o comando" >&2; exit 1; }
mkdir -p "$RUN"

acquire() {
    local n="$1"
    exec {LOCKFD}>"$RUN/emu-$n.lock"
    if flock -n "$LOCKFD"; then EMU_N="$n"; return 0; fi
    exec {LOCKFD}>&-
    return 1
}

EMU_N=""
if [[ -n "$want" ]]; then
    echo "emu-run: aguardando a instância $want…" >&2
    exec {LOCKFD}>"$RUN/emu-$want.lock"; flock "$LOCKFD"; EMU_N="$want"
else
    for _ in $(seq 1 7200); do
        for ((n = 0; n < POOL; n++)); do acquire "$n" && break 2; done
        sleep 5
    done
fi
[[ -n "$EMU_N" ]] || { echo "erro: nenhuma instância livre" >&2; exit 1; }

# Todo filho roda sem o FD da trava (ver o topo).
emu() { "$HERE/emulator-qemu.sh" -i "$EMU_N" "$@" {LOCKFD}>&-; }
cleanup() { emu stop >/dev/null 2>&1 || true; }
trap cleanup EXIT
# QEMU órfão de uma reserva anterior que morreu sem limpar (SIGKILL, crash do host): encerra antes do boot.
if orphan="$(emu pid 2>/dev/null)"; then
    echo "emu-run: QEMU órfão (pid $orphan) na instância $EMU_N; encerrando" >&2
fi
emu stop >/dev/null 2>&1 || true
[[ "$keep" == 1 ]] || emu reset >/dev/null
if [[ -n "$profile" ]]; then
    # Com cota de CPU o boot é bem mais lento: espera mais.
    emu start headless --profile "$profile" >&2
    emu wait "${EMU_BOOT_WAIT:-900}" >&2
else
    emu start headless --smp 2 >&2
    emu wait 240 >&2
fi
eval "$(emu env)"
echo "emu-run: instância $EMU_N pronta (ares $EMU_DEVICE, inspector $EMU_CDP_PORT)" >&2
[[ -z "$profile" ]] || export EMU_PROFILE="$profile"
# --pdeathsig: o timeout fica num grupo de processos próprio e sobreviveria a um SIGKILL do emu-run,
# agindo no emulador da reserva seguinte (de outro agente); com isso ele recebe TERM e repassa ao comando.
setpriv --pdeathsig TERM timeout "$((timeout_min * 60))" "$@" {LOCKFD}>&-
