+/// webOS port (F8.6): the bytes that `ZlibEncoder::new(_, Compression::none())` + `write_all` +
+/// `finish` give (miniz_oxide: zlib header 78 01, stored blocks of 31745 bytes, a final stored block
+/// with the rest, even an empty one, and the Adler-32), written directly. The encoder allocated and
+/// zeroed ~250 KB of compressor state for each stream, and `serialize_meta_details` encodes every
+/// stream of the list on every `get_state`: in wasm2js on the TV that was a third of its time.
+fn zlib_stored(data: &[u8]) -> Vec<u8> {
+    const BLOCK: usize = 31745;
+    let mut out = Vec::with_capacity(data.len() + data.len() / BLOCK * 5 + 11);
+    out.extend_from_slice(&[0x78, 0x01]);
+    let mut rest = data;
+    loop {
+        let last = rest.len() < BLOCK;
+        let (block, next) = rest.split_at(if last { rest.len() } else { BLOCK });
+        let len = block.len() as u16;
+        out.push(last as u8);
+        out.extend_from_slice(&len.to_le_bytes());
+        out.extend_from_slice(&(!len).to_le_bytes());
+        out.extend_from_slice(block);
+        rest = next;
+        if last {
+            break;
+        }
+    }
+    let (mut a, mut b) = (1u32, 0u32);
+    for chunk in data.chunks(5552) {
+        for &byte in chunk {
+            a += byte as u32;
+            b += a;
+        }
+        a %= 65521;
+        b %= 65521;
+    }
+    out.extend_from_slice(&((b << 16) | a).to_be_bytes());
+    out
+}
