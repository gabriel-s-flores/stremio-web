#!/usr/bin/env bash
# Gera o @stremio/stremio-core-web 0.65.0 como WebAssembly MVP (receita A) para o webOS TV 4.x
# (Chromium 53 / V8 5.8 só aceita o MVP; o wasm do npm usa externref, multivalue e bulk memory).
#
#   webos/core/build [--out DIR] [--work DIR] [--jobs N] [--profiling]
#
# --profiling (F8.7, só para medir; exige --out fora do vendor): o mesmo core, mas com os nomes das
# funções e sem inlining (LLVM com -inline-threshold=0, wasm-opt e wasm2js com --no-inline=*), e o
# wasm2js sem o terser. Um perfil de CPU do core no Node (webos/tests/perf/core-bench.js --wasm2js)
# mostra então o tempo próprio de cada modelo, em vez de tudo dentro do WebModel::update. Mais lento
# que o build normal: serve para atribuir, não para medir tempos absolutos.
#
# Receita A: Rust 1.77.2 com gloo-utils 0.2 (recipe-a.patch), os deep links dos streams mais baratos
# (stream-links.patch, F8.6), nada de analytics para um convidado (guest-analytics.patch, F8.7) e a lista de
# streams de Detalhes sem o link do player, que a página monta (list-links.patch, F8.7) e o aquecimento das
# funções de abrir Detalhes (warm-up.patch, F8.7), cargo
# build wasm32-unknown-unknown,
# wasm-bindgen CLI 0.2.121 --target web, wasm-opt -O --signext-lowering, correções na glue (abaixo)
# e a glue, o bridge e o worker transpilados com o Babel do próprio pacote (mesmas versões e
# .babelrc do build oficial). Do mesmo wasm sai a variante wasm2js (fallback sem WebAssembly).
# Saída padrão: webos/vendor/stremio-core-web/ (mesmos nomes do pacote npm, mais o
# stremio_core_web_bg.wasm2js.js) + SOURCE.md.
# Termina com o gate webos/core/check-wasm.
#
# Só depende do kit em ~/webos-tv-sdk: o clone em src/stremio-core (tag stremio-core-web-v0.65.0,
# lido com git archive, sem alterar o clone), o toolchain Rust 1.77.2 (rustup), wasm-bindgen e
# Binaryen em tools/. Crates e pacotes npm vêm dos lockfiles do upstream (cache local ou registro).
# Use via build-run: webos/tools/build-run -- webos/core/build
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
SDK="${WEBOS_SDK:-$HOME/webos-tv-sdk}"
CLONE="$SDK/src/stremio-core"
TAG="stremio-core-web-v0.65.0"
TAG_COMMIT="fa22c9ca8b8574fe7a72460023d05beff2b74026"
VERSION="0.65.0-mvp"
TOOLCHAIN="1.77.2"
BINDGEN="$SDK/tools/bin/wasm-bindgen-0.2.121"
WASM_OPT="$SDK/tools/binaryen-version_133/bin/wasm-opt"
WASM2JS="$SDK/tools/binaryen-version_133/bin/wasm2js"
PATCH="$HERE/recipe-a.patch"
# Desempenho no webOS (F8.6): os deep links dos streams sem recompilar uma regex e sem criar um
# compressor zlib por stream a cada get_state (veja o README).
PERF_PATCH="$HERE/stream-links.patch"
# Desempenho no webOS (F8.7): sem sessão, o evento de analytics não é montado (a 1ª mudança de rota
# compilava uma regex que não servia para nada, segundos do core na TV).
GUEST_PATCH="$HERE/guest-analytics.patch"
# Desempenho no webOS (F8.7): a lista de streams de Detalhes sem o deepLinks.player de cada stream (a página o
# monta, os mesmos bytes, só para os streams que mostra: webos/lib/player-link) e o progresso de cada stream
# comparando primeiro o vídeo.
LIST_PATCH="$HERE/list-links.patch"
# Desempenho no webOS (F8.7): webos_warm_up(), o código de abrir Detalhes rodado antes, num modelo à parte, para o
# wasm2js compilar as funções no ocioso e não no primeiro título aberto.
WARM_PATCH="$HERE/warm-up.patch"
OUT="$REPO/webos/vendor/stremio-core-web"
WORK="$SDK/run/core-build"
JOBS=4
PROFILING=0
W2JS=stremio_core_web_bg.wasm2js.js
# Nome do global que o $W2JS define quando carregado por importScripts (webos/core/loader.js).
W2JS_GLOBAL=stremio_core_web_wasm2js
FILES=(bridge.js worker.js stremio_core_web.js stremio_core_web_bg.wasm "$W2JS" package.json)
# bridge.js e worker.js não dependem do wasm: têm de sair iguais aos do npm 0.65.0.
NPM_SHA256="51c490dcde610baad20f6bf0c2cfc87e6b886830c2c6f80080ce4a7a796199d1  bridge.js
455af735f709befb35ea2b66ae70059551413d39fab5154b8de94823c288ddcc  worker.js"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --out) OUT="$2"; shift 2 ;;
        --work) WORK="$2"; shift 2 ;;
        --jobs) JOBS="$2"; shift 2 ;;
        --profiling) PROFILING=1; shift ;;
        *) echo "uso: build [--out DIR] [--work DIR] [--jobs N] [--profiling]" >&2; exit 1 ;;
    esac
done
if [[ "$PROFILING" == 1 && "$OUT" == "$REPO/webos/vendor/stremio-core-web" ]]; then
    echo "erro: --profiling precisa de --out fora do vendor" >&2
    exit 1
fi
# O build de perfil: nomes e nada de inlining (veja o cabeçalho).
PROFILE_RUSTFLAGS=""
WASM_OPT_FLAGS=(-O --signext-lowering)
WASM2JS_FLAGS=(-O)
if [[ "$PROFILING" == 1 ]]; then
    PROFILE_RUSTFLAGS=" -C llvm-args=-inline-threshold=0"
    WASM_OPT_FLAGS=(--no-inline=* -O --signext-lowering -g)
    WASM2JS_FLAGS=(--no-inline=* -O -g)
fi

step() { echo "==> [$(date +%T)] $*"; }
T0=$SECONDS

step "conferindo ferramentas"
rustup run "$TOOLCHAIN" rustc -V
rustup +"$TOOLCHAIN" target list --installed | grep -qx wasm32-unknown-unknown \
    || { echo "erro: falta o alvo wasm32-unknown-unknown no Rust $TOOLCHAIN" >&2; exit 1; }
"$BINDGEN" --version
"$WASM_OPT" --version
node --version
COMMIT="$(git -C "$CLONE" rev-parse "$TAG^{commit}")"
echo "upstream: $TAG ($COMMIT)"
[[ "$COMMIT" == "$TAG_COMMIT" ]] \
    || { echo "erro: a tag $TAG aponta para $COMMIT no clone (esperado $TAG_COMMIT)" >&2; exit 1; }

step "autoteste do gate"
"$HERE/check-wasm-selftest" > /dev/null || { "$HERE/check-wasm-selftest" >&2; exit 1; }
echo "check-wasm-selftest: ok"

step "extraindo $TAG em $WORK/src"
SRC="$WORK/src"
rm -rf "$SRC" "$WORK/target"
mkdir -p "$SRC"
git -C "$CLONE" archive "$TAG" | tar -x -C "$SRC"
patch -d "$SRC" -p1 --forward --quiet < "$PATCH"
patch -d "$SRC" -p1 --forward --quiet < "$PERF_PATCH"
patch -d "$SRC" -p1 --forward --quiet < "$GUEST_PATCH"
patch -d "$SRC" -p1 --forward --quiet < "$LIST_PATCH"
patch -d "$SRC" -p1 --forward --quiet < "$WARM_PATCH"

step "cargo build (Rust $TOOLCHAIN, wasm32-unknown-unknown, release)"
# Caminhos absolutos entram nas mensagens de panic; o remap deixa o binário igual em qualquer
# pasta de trabalho ou máquina.
CARGO_DIR="${CARGO_HOME:-$HOME/.cargo}"
(
    cd "$SRC/stremio-core-web"
    unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS CARGO_BUILD_RUSTFLAGS
    export RUSTUP_TOOLCHAIN="$TOOLCHAIN" CARGO_TARGET_DIR="$WORK/target" \
        RUSTFLAGS="--remap-path-prefix=$SRC=/stremio-core --remap-path-prefix=$CARGO_DIR=/cargo$PROFILE_RUSTFLAGS"
    cargo build --release --locked --target wasm32-unknown-unknown --jobs "$JOBS"
)

step "wasm-bindgen --target web"
"$BINDGEN" --target web --no-typescript --out-dir "$SRC/stremio-core-web/wasm_build" \
    "$WORK/target/wasm32-unknown-unknown/release/stremio_core_web.wasm"

step "glue: correções para o Chromium 53 e para o wasm2js"
# A glue é a mesma para as duas variantes (WASM e wasm2js). Cada trecho tem de aparecer uma vez.
#
# 1. TextDecoder recebe cópia da memória: no Chromium 53 do webOS, certos usos de uma view do
#    memory.buffer seguidos de memory.grow derrubam o processo do app (medido no emulador):
#    TextDecoder.decode(view), crypto.getRandomValues(view) e até new Uint8Array(view) depois de
#    escrever na view. O core caía no primeiro grow, em get_state('ctx'), pelo TextDecoder da glue;
#    com slice() ele recebe uma cópia. O resto da glue só usa padrões validados no emulador (escrita
#    indexada na view inteira, subarray().set(), DataView). Qualquer outro uso de view da memória
#    precisa de repro no emulador antes. No wasm2js a cópia é inofensiva (só custa a cópia).
# 2 e 3. Views em cache refeitas quando o buffer muda: no wasm2js a memória é um ArrayBuffer comum,
#    trocado por outro maior no grow, e o antigo não é destacado (byteLength continua > 0). Sem isso
#    a glue lê e escreve no buffer velho (no spike: strings UTF-8 inválidas e o trap "abort"). No WASM o buffer
#    também muda a cada grow, então a checagem equivale à original.
# 4. Gancho no __wbg_load: se o argumento traz webosInstantiate(imports), a glue entrega os imports
#    a ele, que devolve { instance, module }. É assim que webos/core/loader.js escolhe WASM ou
#    wasm2js em runtime sem que a glue precise do objeto WebAssembly.
node -e '
    const fs = require("fs");
    const file = process.argv[1];
    const edits = [
        ["cachedTextDecoder.decode(getUint8ArrayMemory0().subarray(ptr, ptr + len))",
         "cachedTextDecoder.decode(getUint8ArrayMemory0().slice(ptr, ptr + len))"],
        ["cachedDataViewMemory0 === null || cachedDataViewMemory0.buffer.detached === true || (cachedDataViewMemory0.buffer.detached === undefined && cachedDataViewMemory0.buffer !== wasm.memory.buffer)",
         "cachedDataViewMemory0 === null || cachedDataViewMemory0.buffer !== wasm.memory.buffer"],
        ["cachedUint8ArrayMemory0 === null || cachedUint8ArrayMemory0.byteLength === 0",
         "cachedUint8ArrayMemory0 === null || cachedUint8ArrayMemory0.buffer !== wasm.memory.buffer"],
        ["async function __wbg_load(module, imports) {\n",
         "async function __wbg_load(module, imports) {\n" +
         "    if (module && typeof module.webosInstantiate === \"function\") return await module.webosInstantiate(imports);\n"]
    ];
    let src = fs.readFileSync(file, "utf8");
    for (const [from, to] of edits) {
        const count = src.split(from).length - 1;
        if (count !== 1) {
            console.error("erro: trecho da glue encontrado " + count + " vezes (esperado 1): " + from);
            process.exit(1);
        }
        src = src.replace(from, () => to);
    }
    fs.writeFileSync(file, src);
' "$SRC/stremio-core-web/wasm_build/stremio_core_web.js"

step "wasm-opt ${WASM_OPT_FLAGS[*]}"
"$WASM_OPT" "${WASM_OPT_FLAGS[@]}" "$SRC/stremio-core-web/wasm_build/stremio_core_web_bg.wasm" \
    -o "$SRC/stremio-core-web/stremio_core_web_bg.wasm"

step "wasm2js -O (variante sem WebAssembly)"
# O mesmo wasm MVP traduzido para JS. A saída do wasm2js é um módulo ES que importa a glue e se
# instancia ao carregar; aqui ela vira um script clássico que só define a fábrica asmFunc(imports)
# (no global $W2JS_GLOBAL, ou module.exports no Node), para o carregador instanciar com os imports
# da glue quando faltar o WebAssembly.
"$WASM2JS" "$SRC/stremio-core-web/stremio_core_web_bg.wasm" "${WASM2JS_FLAGS[@]}" -o "$SRC/stremio-core-web/wasm_build/$W2JS.mjs"
node -e '
    const fs = require("fs");
    const [from, to, name] = process.argv.slice(1);
    const lines = fs.readFileSync(from, "utf8").split("\n");
    const head = "import * as $_stremio_core_web_bg_js from \x27./stremio_core_web_bg.js\x27;";
    const tail = lines.indexOf("var retasmFunc = asmFunc({");
    const body = lines.slice(1, tail);
    if (lines[0] !== head || tail < 0 || body.some((l) => /^(import|export) /.test(l))
        || body.filter((l) => l === "function asmFunc(imports) {").length !== 1) {
        console.error("erro: saída do wasm2js em formato inesperado (" + from + ")");
        process.exit(1);
    }
    fs.writeFileSync(to, [
        "// @stremio/stremio-core-web 0.65.0 (MVP) traduzido pelo wasm2js; gerado por webos/core/build.",
        "// Define a fábrica asmFunc(imports), que devolve os exports do core como um WebAssembly.Instance.",
        "(function (root, factory) {",
        "    if (typeof module === \x27object\x27 && module.exports) module.exports = factory();",
        "    else root." + name + " = factory();",
        "})(typeof self !== \x27undefined\x27 ? self : this, function () {",
        body.join("\n"),
        "return asmFunc;",
        "});",
        ""
    ].join("\n"));
' "$SRC/stremio-core-web/wasm_build/$W2JS.mjs" "$SRC/stremio-core-web/$W2JS" "$W2JS_GLOBAL"
node --check "$SRC/stremio-core-web/$W2JS"

step "wasm2js: terser e fábrica eager (webos/core/wasm2js-finish.js)"
# No V8 5.8 o embrulho acima custa três passadas de análise sobre o arquivo (importScripts, fábrica
# e asmFunc); com a fábrica e asmFunc entre parênteses, uma só. O terser (opções padrão, o mesmo que
# o ares-package aplicaria) leva o arquivo de 32,6 MB a 9,4 MB. No perfil c8 do emulador o init do
# wasm2js cai de ~19 s para ~9 s (spike webos/spikes/core-init, F0.11). Usa o terser e o acorn do
# node_modules do repo (pnpm install).
node -e 'require.resolve("terser-webpack-plugin", { paths: [process.argv[1]] }); require.resolve("webpack", { paths: [process.argv[1]] })' "$REPO" \
    || { echo "erro: falta o node_modules do repo (pnpm install --frozen-lockfile)" >&2; exit 1; }
mv "$SRC/stremio-core-web/$W2JS" "$SRC/stremio-core-web/wasm_build/$W2JS.wrapped"
if [[ "$PROFILING" == 1 ]]; then
    # Os nomes ficam no arquivo: sem o terser (o Node não precisa da fábrica entre parênteses).
    cp "$SRC/stremio-core-web/wasm_build/$W2JS.wrapped" "$SRC/stremio-core-web/$W2JS"
else
    node --max-old-space-size=8000 "$HERE/wasm2js-finish.js" "$SRC/stremio-core-web/wasm_build/$W2JS.wrapped" "$SRC/stremio-core-web/$W2JS"
fi
node --check "$SRC/stremio-core-web/$W2JS"

step "Babel (devDependencies e .babelrc do upstream)"
(
    cd "$SRC/stremio-core-web"
    # O preset-env não tem targets: sem browserslist do ambiente ele gera ES5, como o build oficial.
    unset BROWSERSLIST BROWSERSLIST_ENV BROWSERSLIST_CONFIG BROWSERSLIST_STATS
    npm ci --ignore-scripts --no-audit --no-fund --prefer-offline --loglevel=error
    BABEL=./node_modules/.bin/babel
    "$BABEL" wasm_build/stremio_core_web.js --config-file ./.babelrc --out-file stremio_core_web.js
    "$BABEL" src/bridge.js --config-file ./.babelrc --out-file bridge.js
    "$BABEL" src/worker.js --config-file ./.babelrc --out-file worker.js
    echo "$NPM_SHA256" | sha256sum --quiet -c - \
        || { echo "erro: bridge.js/worker.js diferentes dos do npm 0.65.0 (Babel ou ambiente)" >&2; exit 1; }
    node -e '
        const fs = require("fs");
        const pkg = JSON.parse(fs.readFileSync("package.json", "utf8"));
        pkg.version = process.argv[1];
        fs.writeFileSync("package.mvp.json", JSON.stringify(pkg, null, 4) + "\n");
    ' "$VERSION"
)

step "copiando para $OUT"
mkdir -p "$OUT"
for f in "${FILES[@]}"; do rm -f "$OUT/$f"; done
cp "$SRC/stremio-core-web/"{bridge.js,worker.js,stremio_core_web.js,stremio_core_web_bg.wasm,"$W2JS"} "$OUT/"
cp "$SRC/stremio-core-web/package.mvp.json" "$OUT/package.json"

step "SOURCE.md"
TERSER_VERSION="$(node -p 'require(require.resolve("terser/package.json", { paths: [require("path").dirname(require.resolve("terser-webpack-plugin", { paths: [process.argv[1]] }))] })).version' "$REPO")"
ACORN_VERSION="$(node -p 'require(require.resolve("acorn/package.json", { paths: [require("path").dirname(require.resolve("webpack", { paths: [process.argv[1]] }))] })).version' "$REPO")"
BABEL_VERSIONS="$(cd "$SRC/stremio-core-web" && node -p '
    ["@babel/core", "@babel/cli", "@babel/preset-env", "@babel/plugin-transform-runtime",
     "babel-plugin-bundled-import-meta"]
        .map((n) => n + " " + require("./node_modules/" + n + "/package.json").version).join(", ")')"
{
    cat <<EOF
# @stremio/stremio-core-web $VERSION (WebAssembly MVP)

Gerado por \`webos/core/build\`. Não edite à mão: rode o script de novo.

- **Upstream:** https://github.com/Stremio/stremio-core, tag \`$TAG\` (commit \`$COMMIT\`), pasta \`stremio-core-web\`
- **Patch:** \`webos/core/recipe-a.patch\` (sha256 \`$(sha256sum "$PATCH" | cut -d' ' -f1)\`): \`gloo-utils\` 0.3 → 0.2, a única dependência do lockfile que exige Rust acima de 1.77; \`webos/core/stream-links.patch\` (sha256 \`$(sha256sum "$PERF_PATCH" | cut -d' ' -f1)\`): a regex dos links de player externo compilada uma vez e o zlib sem compressão do link do player escrito direto, com os mesmos bytes (F8.6); \`webos/core/guest-analytics.patch\` (sha256 \`$(sha256sum "$GUEST_PATCH" | cut -d' ' -f1)\`): sem sessão, o evento de analytics não é montado (o \`Analytics::emit\` já o descartava; F8.7); \`webos/core/list-links.patch\` (sha256 \`$(sha256sum "$LIST_PATCH" | cut -d' ' -f1)\`): a lista de streams de \`meta_details\` sem o \`deepLinks.player\`, que a página monta com os mesmos bytes (\`webos/lib/player-link\`), e o progresso de cada stream comparando primeiro o vídeo (F8.7); \`webos/core/warm-up.patch\` (sha256 \`$(sha256sum "$WARM_PATCH" | cut -d' ' -f1)\`): \`webos_warm_up()\`, o código de abrir Detalhes rodado num modelo à parte, sem rede nem estado, para o wasm2js compilar as funções antes do primeiro título (F8.7)
- **Rust:** $(rustup run "$TOOLCHAIN" rustc -V), \`cargo build --release --locked --target wasm32-unknown-unknown\` com \`--remap-path-prefix\` da pasta de trabalho e do \`CARGO_HOME\`
- **wasm-bindgen:** $("$BINDGEN" --version), \`--target web --no-typescript\`
- **Binaryen:** $("$WASM_OPT" --version), \`wasm-opt -O --signext-lowering\`
- **Babel:** $BABEL_VERSIONS, com o \`.babelrc\` do upstream (como \`scripts/build.sh\`)
- **wasm2js:** $("$WASM2JS" --version), \`wasm2js -O\` sobre o mesmo \`stremio_core_web_bg.wasm\`; a saída (módulo ES) vira um script clássico que define a fábrica \`asmFunc(imports)\` no global \`$W2JS_GLOBAL\` (\`$W2JS\`), minificado pelo terser $TERSER_VERSION (opções padrão) e com a fábrica e \`asmFunc\` entre parênteses para o V8 5.8 analisá-las numa passada só (\`webos/core/wasm2js-finish.js\`, acorn $ACORN_VERSION). Usado só quando falta o WebAssembly ou a compilação/instanciação do wasm falha (\`webos/core/loader.js\`)
- **Glue** (a mesma para WASM e wasm2js):
  1. em \`getStringFromWasm0\`, \`TextDecoder.decode\` recebe \`slice()\` (cópia) em vez de \`subarray()\` (view da memória wasm). No Chromium 53 do webOS, certos usos de uma view do \`memory.buffer\` seguidos de \`memory.grow\` derrubam o processo do app (\`TextDecoder.decode(view)\`, \`crypto.getRandomValues(view)\`, \`new Uint8Array(view)\` depois de escrever na view). O resto da glue só usa padrões validados no emulador (escrita indexada na view inteira, \`subarray().set()\`, \`DataView\`); qualquer outro uso de view da memória precisa de repro no emulador antes. No wasm2js a cópia é inofensiva;
  2. e 3. o \`DataView\` e o \`Uint8Array\` em cache são refeitos quando \`buffer !== wasm.memory.buffer\`. No wasm2js o \`grow\` troca o \`ArrayBuffer\` sem destacar o antigo, e as checagens originais (\`detached\`, \`byteLength === 0\`) não percebem a troca;
  4. \`__wbg_load\` aceita um objeto com \`webosInstantiate(imports)\`, que devolve \`{ instance, module }\`: é por ele que o carregador entrega à glue o core WASM ou o wasm2js
- **Diferenças para o pacote npm:** o \`stremio_core_web_bg.wasm\` (MVP), o \`$W2JS\` (novo), a glue \`stremio_core_web.js\` gerada para o MVP (com as correções acima) e a versão \`$VERSION\` no \`package.json\`. O \`bridge.js\` e o \`worker.js\` saem da mesma fonte e do mesmo Babel. \`README.md\` e \`rust-toolchain.toml\` do pacote npm não são copiados.

## Checksums (sha256)

| Arquivo | Bytes | sha256 |
|---|---|---|
EOF
    for f in "${FILES[@]}"; do
        echo "| \`$f\` | $(stat -c %s "$OUT/$f") | \`$(sha256sum "$OUT/$f" | cut -d' ' -f1)\` |"
    done
} > "$OUT/SOURCE.md"

step "gate: check-wasm"
"$HERE/check-wasm" "$OUT/stremio_core_web_bg.wasm"

step "pronto em $((SECONDS - T0)) s"
(cd "$OUT" && sha256sum "${FILES[@]}")
