+/// webOS port (F8.7): the answer of an addon read straight from its text, for `fetch`.
+///
+/// [`ResourceResponse`]'s `Deserialize` builds the whole answer as a `serde_json::Value` (every key of every
+/// item, through `serde_path_to_error`) and then converts the one variant it has. In wasm2js on the webOS
+/// TV 4.x that was most of the time the core spent on the addons' answers (catalogs of 100 items, 224
+/// streams). This reads the top-level keys as raw text (nothing is built for them) and deserializes only the
+/// variant's text. It gives the same answer as the `Deserialize` impl or none at all: anything that impl
+/// would refuse (not an object, none or more than one of the variant keys, a variant that does not
+/// deserialize, a `null` meta) gives `None`, and the caller reads the text again the usual way, for the same
+/// error. Repeated keys keep the last one, as the `Value` did.
+pub fn resource_response_from_text(text: &str) -> Option<ResourceResponse> {
+    use serde_json::value::RawValue;
+    use std::collections::HashMap;
+
+    let object = serde_json::from_str::<HashMap<String, &RawValue>>(text).ok()?;
+    let keys = [
+        "metas",
+        "metasDetailed",
+        "meta",
+        "streams",
+        "subtitles",
+        "addons",
+    ];
+    let mut present = keys.iter().filter(|key| object.contains_key(**key));
+    let key = *present.next()?;
+    if present.next().is_some() {
+        return None;
+    }
+    let raw = object.get(key)?.get();
+    let is_null = raw.trim() == "null";
+    // The whole list first, item by item straight from the text; only a list with an item that does not
+    // deserialize goes through SkipError, which buffers every item (to skip the bad ones): the same items.
+    fn list<T: for<'a> Deserialize<'a> + Serialize>(raw: &str) -> Option<Vec<T>> {
+        serde_json::from_str::<Vec<T>>(raw)
+            .ok()
+            .or_else(|| serde_json::from_str::<SkipError<T>>(raw).ok().map(|skip| skip.0))
+    }
+    match key {
+        "metas" => Some(ResourceResponse::Metas {
+            metas: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        "metasDetailed" => Some(ResourceResponse::MetasDetailed {
+            metas_detailed: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        "meta" => Some(ResourceResponse::Meta {
+            meta: serde_json::from_str(raw).ok()?,
+        }),
+        "streams" => Some(ResourceResponse::Streams {
+            streams: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        "subtitles" => Some(ResourceResponse::Subtitles {
+            subtitles: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        "addons" => Some(ResourceResponse::Addons {
+            addons: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        _ => None,
+    }
+}
