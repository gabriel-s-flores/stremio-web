 #[cfg(test)]
 mod tests {
     use serde_json::from_value;
 
+    /// webOS port (F8.7): resource_response_from_text gives what the Deserialize impl gives, or nothing
+    /// where it fails.
+    #[test]
+    fn from_text_is_the_deserialize_impl_or_nothing() {
+        let meta = r#"{"id":"tt1","type":"series","name":"A \"b\" é","poster":"https://p/1.jpg","releaseInfo":2019,"imdbRating":7.1,"genres":["Drama"],"cast":["x"],"popularities":{"a":1},"trailers":[{"source":"yt","type":"Trailer"}],"behaviorHints":{"defaultVideoId":null,"other":{"k":[1,2]}},"videos":[{"id":"tt1:1:1","name":"Pilot","season":1,"episode":1,"number":1,"released":"2019-01-01T00:00:00.000Z","overview":"o"},{"id":"tt1:0:1","title":"Extra","season":0,"episode":1},{"no_id":true}]}"#;
+        let stream = r#"{"name":"T\n4k","title":"F.mkv\n👤 4","url":"https://d.example/a%20b.mkv","behaviorHints":{"bingeGroup":"g","filename":"F.mkv","videoSize":19650000000,"notWebReady":true}}"#;
+        let cases = vec![
+            format!(r#"{{"metas":[{meta},7,null,{{"name":"no id"}},{meta}],"cacheMaxAge":3600}}"#),
+            format!(r#"{{"metasDetailed":[{meta},{{"id":1}}]}}"#),
+            format!(r#"{{"metasDetailed":[{meta},{meta}]}}"#),
+            format!(r#"{{"metas":[{meta},{meta}]}}"#),
+            format!(r#"{{"streams":[{stream},{stream}]}}"#),
+            format!(r#"{{"meta":{meta}}}"#),
+            format!(r#"{{"streams":[{stream},{{"url":"not a url"}},{{"ytId":"abc"}},{{"externalUrl":"https://e/x"}},{{"infoHash":"dd8255ecdc7ca55fb0bbf81323d87062db1f6d1c","fileIdx":0}}]}}"#),
+            r#"{"subtitles":[{"id":"1","url":"https://s/1.srt","lang":"por"},{"bad":1}]}"#.to_owned(),
+            r#"{"addons":[]}"#.to_owned(),
+            r#"{"metas":null}"#.to_owned(),
+            r#"{"streams":null,"cacheMaxAge":1}"#.to_owned(),
+            r#"{"meta":null}"#.to_owned(),
+            r#"{"metas":[],"metas":[{"id":"tt2","type":"movie","name":"Last"}]}"#.to_owned(),
+            r#"{"metas":[],"meta":{}}"#.to_owned(),
+            r#"{"unknown":1}"#.to_owned(),
+            r#"{"metas":{"object_key":"value"}}"#.to_owned(),
+            r#"{"streams":"x"}"#.to_owned(),
+            r#"256"#.to_owned(),
+            r#"[{"metas":[]}]"#.to_owned(),
+            r#"{"metas":[1,2"#.to_owned(),
+            r#"{"some_key":{"valid_value":9999999999999999999999999,5}}"#.to_owned(),
+            r#"{"metas":[],"x":9999999999999999999999999}"#.to_owned(),
+        ];
+        for case in cases {
+            let canonical = serde_json::from_str::<super::ResourceResponse>(&case).ok();
+            assert_eq!(super::resource_response_from_text(&case), canonical, "{case}");
+        }
+    }
