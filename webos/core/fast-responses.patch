+/// webOS port (F8.7): the answer of an addon read straight from its text, for `fetch`.
+///
+/// [`ResourceResponse`]'s `Deserialize` builds the whole answer as a `serde_json::Value` (every key of every
+/// item, through `serde_path_to_error`) and then converts the one variant it has, item by item through
+/// `SkipError`. In wasm2js on the webOS TV 4.x that was most of the time the core spent on the addons'
+/// answers (catalogs of 100 items, 224 streams). This reads the top-level keys as raw text (nothing is built
+/// for them) and deserializes the variant's list strictly, straight from its text.
+///
+/// It gives the answer of the `Deserialize` impl, or `None`, and then the caller reads the text again the
+/// usual way (the same answer, or the same error). `None` for anything that impl would refuse (not an object,
+/// none or more than one of the variant keys, a `null` meta) and for any list the strict read refuses: an
+/// item that does not deserialize, which `SkipError` would skip, but also an item with a repeated key, which
+/// the `Value` reads as its last value and `SkipError` straight from the text would drop. Only lists whose
+/// items all deserialize take this path (almost every answer).
+///
+/// One way it is more permissive, never less: a value the `Value` refuses in a key no struct reads (a number
+/// out of range like `1e999`, nesting deeper than 128, a lone surrogate escape) is skipped here without being
+/// checked, so such an answer is read instead of refused. Repeated top-level keys keep the last one, as the
+/// `Value` did.
+pub fn resource_response_from_text(text: &str) -> Option<ResourceResponse> {
+    use serde_json::value::RawValue;
+    use std::collections::HashMap;
+
+    let object = serde_json::from_str::<HashMap<String, &RawValue>>(text).ok()?;
+    let keys = [
+        "metas",
+        "metasDetailed",
+        "meta",
+        "streams",
+        "subtitles",
+        "addons",
+    ];
+    let mut present = keys.iter().filter(|key| object.contains_key(**key));
+    let key = *present.next()?;
+    if present.next().is_some() {
+        return None;
+    }
+    let raw = object.get(key)?.get();
+    let is_null = raw.trim() == "null";
+    // The whole list, strictly, straight from the text; a list it refuses goes back to the usual way.
+    fn list<T: for<'a> Deserialize<'a> + Serialize>(raw: &str) -> Option<Vec<T>> {
+        serde_json::from_str::<Vec<T>>(raw).ok()
+    }
+    match key {
+        "metas" => Some(ResourceResponse::Metas {
+            metas: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        "metasDetailed" => Some(ResourceResponse::MetasDetailed {
+            metas_detailed: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        "meta" => Some(ResourceResponse::Meta {
+            meta: serde_json::from_str(raw).ok()?,
+        }),
+        "streams" => Some(ResourceResponse::Streams {
+            streams: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        "subtitles" => Some(ResourceResponse::Subtitles {
+            subtitles: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        "addons" => Some(ResourceResponse::Addons {
+            addons: if is_null {
+                vec![]
+            } else {
+                list(raw)?
+            },
+        }),
+        _ => None,
+    }
+}
