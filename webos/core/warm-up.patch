+/// webOS port (F8.7): the code a title's Details runs, run once in advance on a copy of the model.
+///
+/// In wasm2js on the webOS TV 4.x (V8 5.8 with "--no-crankshaft") the first run of a code path of the core
+/// costs hundreds of ms (the functions are compiled when first called: the first `dispatch` took ~700 ms on
+/// the C8 profile, the next ones 1-2 ms), and opening the first title of a session paid it for the meta and
+/// the streams answers, an addon that fails and the `get_state` of the details. Called by the page when the
+/// app is idle: a copy of the runtime's model (copying it makes no effect) gets the Details of a movie and of
+/// a series episode, set up as the Load leaves them (the requests loading), canned answers read as `fetch` reads
+/// an addon's answer (one stream addon answers an error) and its `get_state('meta_details')`; the Load
+/// action is only parsed (its update would make the requests: the core's fetch starts when the effect is
+/// built). The copy's effects are dropped: nothing reaches the runtime, the storage, the network or the page.
+/// One request is made on purpose, through the runtime's fetch: the streaming server's local addon
+/// (127.0.0.1:11470; the core asks it on every Details, and there is no server on the TV), which fails at once
+/// and warms fetch's error path. Returns how many titles it went through (0 when the runtime is not ready).
+#[wasm_bindgen]
+pub fn webos_warm_up() -> u32 {
+    let mut model = {
+        let runtime = RUNTIME.read().expect("runtime read failed");
+        match runtime.as_ref().and_then(|runtime| runtime.ready()) {
+            Some(runtime) => match runtime.model() {
+                Ok(model) => model.to_owned(),
+                Err(_) => return 0,
+            },
+            None => return 0,
+        }
+    };
+    let bases = model
+        .ctx
+        .profile
+        .addons
+        .iter()
+        .take(2)
+        .map(|addon| addon.transport_url.to_owned())
+        .collect::<Vec<_>>();
+    if bases.is_empty() {
+        return 0;
+    }
+    // What fetch does with an addon's answer (webos/core/fast-responses.patch): the fast read, else the usual one.
+    let answer = |text: &str| -> Result<ResourceResponse, EnvError> {
+        resource_response_from_text(text).map(Ok).unwrap_or_else(|| {
+            serde_path_to_error::deserialize(&mut serde_json::Deserializer::from_str(text))
+                .map_err(|error| EnvError::Fetch(error.to_string()))
+        })
+    };
+    let mut titles = 0;
+    for (r#type, id, video_id, meta) in [
+        ("movie", "tt0000001", "tt0000001", WARM_UP_MOVIE),
+        ("series", "tt0000002", "tt0000002:1:1", WARM_UP_SERIES),
+    ] {
+        let action = format!(
+            r#"{{"action":"Load","args":{{"model":"MetaDetails","args":{{"metaPath":{{"resource":"meta","type":"{type}","id":"{id}","extra":[]}},"streamPath":{{"resource":"stream","type":"{type}","id":"{video_id}","extra":[]}},"guessStream":false}}}}}}"#
+        );
+        let selected = match serde_json::from_str::<Action>(&action) {
+            Ok(Action::Load(ActionLoad::MetaDetails(selected))) => selected,
+            _ => return titles,
+        };
+        let request = |base: &url::Url, path: &ResourcePath| ResourceRequest {
+            base: base.to_owned(),
+            path: path.to_owned(),
+        };
+        let meta_request = request(&bases[0], &selected.meta_path);
+        let stream_requests = match &selected.stream_path {
+            Some(path) => bases.iter().map(|base| request(base, path)).collect::<Vec<_>>(),
+            None => vec![],
+        };
+        model.meta_details = MetaDetails {
+            selected: Some(selected),
+            meta_items: vec![ResourceLoadable {
+                request: meta_request.to_owned(),
+                content: Some(Loadable::Loading),
+            }],
+            streams: stream_requests
+                .iter()
+                .map(|request| ResourceLoadable {
+                    request: request.to_owned(),
+                    content: Some(Loadable::Loading),
+                })
+                .collect(),
+            ..Default::default()
+        };
+        let _ = model.get_state(&WebModelField::MetaDetails);
+        let mut answers = vec![(meta_request, answer(meta))];
+        let count = stream_requests.len();
+        for (index, request) in stream_requests.into_iter().enumerate() {
+            // The first addon answers; the last one of several fails.
+            let result = if index + 1 == count && count > 1 {
+                Err(EnvError::Fetch("Failed to fetch".to_owned()))
+            } else {
+                answer(WARM_UP_STREAMS)
+            };
+            answers.push((request, result));
+        }
+        for (request, result) in answers {
+            let _ = model.update(&Msg::Internal(Internal::ResourceRequestResult(
+                request,
+                Box::new(result),
+            )));
+            let _ = model.get_state(&WebModelField::MetaDetails);
+        }
+        titles += 1;
+    }
+    drop(model);
+    // fetch's error path, with a request that fails at once on the TV (no streaming server).
+    if let Ok(request) = http::Request::get("http://127.0.0.1:11470/local-addon/manifest.json")
+        .body(())
+    {
+        WebEnv::exec_concurrent(
+            WebEnv::fetch::<(), ResourceResponse>(request).map(|_| ()),
+        );
+    }
+    titles
+}
